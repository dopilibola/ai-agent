# =============================================================================
# AI Sales — Shared environment
# =============================================================================

# OpenAI (used via langchain-openai and litellm)
OPENAI_API_KEY=

# Telegram API credentials (https://my.telegram.org)
# Shared across tenants when using user-account channels.
TG_API_ID=
TG_API_HASH=

# =============================================================================
# Tenant: oygul (flower shop)
# =============================================================================

# Customer-facing userbot (Telethon user account, "Lola")
OYGUL_CUSTOMER_SESSION=data/oygul_customer
# Merchant-facing bot (Telethon bot token from @BotFather)
OYGUL_MERCHANT_BOT_TOKEN=
OYGUL_MERCHANT_SESSION=data/oygul_merchant
# Comma-separated Telegram user IDs allowed in the merchant bot
OYGUL_MERCHANT_ALLOWED_IDS=
# Comma-separated Telegram chat IDs that receive operator notifications
OYGUL_OPERATOR_CHAT_IDS=
# Click.uz payment config
OYGUL_CLICK_SERVICE_ID=30067
OYGUL_CLICK_MERCHANT_ID=22535
OYGUL_CLICK_TRANSACTION_PARAM=165884
OYGUL_CLICK_RETURN_URL=tg://user?id=7451326382
# ChromaDB (oygul-specific collection)
OYGUL_CHROMA_PATH=data/oygul_chroma
OYGUL_COLLECTION_NAME=bouquets
# Branch a merchant-added bouquet is filed under (blank = single-branch shop).
OYGUL_BRANCH_ID=
# Cloudflare Images — hosts merchant-uploaded bouquet photos (add_bouquet_tool).
# Account id is in the Images dashboard URL; the token must be Images-scoped.
OYGUL_CF_ACCOUNT_ID=
OYGUL_CF_IMAGES_TOKEN=
# Which delivery variant URL to store (must exist in your CF Images variants).
OYGUL_CF_IMAGES_VARIANT=public

# =============================================================================
# Tenant: anfa (clinic — Anfa, Tashkent)
# =============================================================================

# Bot (Telethon bot token from @BotFather)
ANFA_BOT_TOKEN=
ANFA_BOT_SESSION=data/anfa_bot
# Userbot (Telethon user account)
ANFA_USERBOT_SESSION=data/anfa_userbot
ANFA_USERBOT_PHONE=
# Catalog: anfa's service catalog lives in Postgres, fed by the clinic's Excel
# export. Import it via the admin panel upload, or once with:
#   uv run python scripts/anfa_import_catalog.py apps/anfa/exports/medplus_export.xlsx   (after `alembic upgrade head`)
# Comma-separated Telegram chat IDs that receive operator-handoff notifications
ANFA_MODERATOR_CHAT_IDS=1207413315,276690768
# Sync loop — short so an Excel re-import becomes searchable within minutes
ANFA_SYNC_INTERVAL_SECONDS=300
# ChromaDB (anfa-specific collection)
ANFA_CHROMA_PATH=data/anfa_chroma
ANFA_COLLECTION_NAME=clinic_kb

# =============================================================================
# Maskan — grave care (client userbot + operator bot + scheduler + watcher)
# =============================================================================
# Client-facing userbot ("Dilnoza"). Run scripts/maskan_telethon_login.py once
# to create the session, then it connects headlessly.
MASKAN_USERBOT_SESSION=data/maskan_userbot
MASKAN_USERBOT_PHONE=
# Operator bot — funnel notifications + inline buttons + the staff manager
# agent. This is a SEPARATE bot from Maskan's existing @Maskanuzbot order bot;
# give it its own token so the two callback namespaces don't collide.
MASKAN_BOT_TOKEN=
MASKAN_BOT_SESSION=data/maskan_bot
# Staff Telegram ids: who may DM the manager agent / press the funnel buttons.
MASKAN_MANAGER_ALLOWED_IDS=
# Staff who receive funnel notifications (new case, handoff, SLA breaches).
MASKAN_OPERATOR_CHAT_IDS=

# --- Maskan Django backend (the source of truth for catalogue/graves/orders) --
# Production: https://app.mas-kan.uz   ·   local dev: http://127.0.0.1:8010
MASKAN_API_BASE=https://app.mas-kan.uz
# Shared secret — MUST equal BOT_API_KEY in the Maskan backend's own .env.
#   generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
MASKAN_API_KEY=
MASKAN_API_TIMEOUT=20
# Reference data (services, cemeteries) is cached in-process for this long.
MASKAN_API_CACHE_SECONDS=300

# --- scheduler + order watcher ---
MASKAN_SCHEDULER_INTERVAL_SECONDS=60
MASKAN_SCHEDULER_BATCH_SIZE=20
MASKAN_SCHEDULER_MAX_ATTEMPTS=5
# How often we poll the backend for payment / work-status changes.
MASKAN_WATCHER_INTERVAL_SECONDS=120
MASKAN_WATCHER_BATCH_SIZE=40

# --- payments: the bot's OWN merchant account (Payme + Uzum) ---
# With these set, create_order issues checkout links against YOUR merchant
# account instead of the Maskan backend's, and `maskan-payments-api` receives
# the providers' callbacks. Leave a provider's id empty to disable it.
MASKAN_PAYME_MERCHANT_ID=
MASKAN_PAYME_MERCHANT_KEY=
MASKAN_PAYME_TEST_MODE=1
# The `ac.<field>` name as spelled in your Payme cabinet; its value is a
# maskan_payments.id.
MASKAN_PAYME_ACCOUNT_FIELD=order_id
MASKAN_UZUM_SERVICE_ID=
MASKAN_UZUM_LOGIN=
MASKAN_UZUM_PASSWORD=
MASKAN_UZUM_CHECKOUT_URL=https://www.uzumbank.uz/open-service
# Webhook service bind (behind nginx+TLS) and how fast the bot reacts to a paid
# invoice.
MASKAN_PAYMENTS_API_HOST=127.0.0.1
MASKAN_PAYMENTS_API_PORT=58230
MASKAN_PAYMENT_WATCHER_INTERVAL_SECONDS=20

# --- service area (where caretakers actually work) ---
MASKAN_ALLOWED_REGIONS=toshkent,tashkent,тошкент,ташкент
MASKAN_SERVICE_AREA_LABEL=Тошкент шаҳри ва Тошкент вилояти

# --- business facts (interpolated into message templates) ---
MASKAN_SUPPORT_PHONE=+998 71 200 00 00
MASKAN_APP_ANDROID_URL=https://play.google.com/store/apps/details?id=uz.maskan.app
MASKAN_APP_IOS_URL=
MASKAN_WEBSITE_URL=https://mas-kan.uz
# Where clients get their app login + password (the existing Maskan bot).
MASKAN_ACCOUNT_BOT_URL=https://t.me/Maskanuzbot?start=parol

# --- memorial calendar (the seasonal demand driver) ---
# In Uzbekistan graves are visited before Hayit (Ramazon/Qurbon) and on Arafa.
# Those dates are lunar and move every year, so fill in the coming year's dates
# and the funnel sends a reminder MASKAN_MEMORIAL_LEAD_DAYS before each.
# Empty = the seasonal touch is simply never scheduled.
MASKAN_MEMORIAL_DATES=
MASKAN_MEMORIAL_LEAD_DAYS=10
# Hour of day (Tashkent) for day-scale sends, so nothing lands at 03:00.
MASKAN_DAYTIME_SEND_HOUR=10

# =============================================================================
# Shared defaults (override per-process if needed)
# =============================================================================
# Chat, voice transcription, and embeddings all run on Google Gemini by
# default. Each is provider-switchable; the OpenAI/Groq paths remain available.
#   CHAT_PROVIDER=google_genai  CHAT_MODEL=gemini-3.6-flash   (default)
#   CHAT_PROVIDER=openai        CHAT_MODEL=gpt-4o-mini
#   CHAT_PROVIDER=groq          CHAT_MODEL=openai/gpt-oss-20b
CHAT_PROVIDER=google_genai
CHAT_MODEL=gemini-3.6-flash
# langchain's google_genai chat path reads GOOGLE_API_KEY.
GOOGLE_API_KEY=
GROQ_API_KEY=
# Voice transcription — Gemini (google_genai) or OpenAI Whisper (openai).
TRANSCRIBE_PROVIDER=google_genai
TRANSCRIBE_MODEL=gemini-2.5-flash
# Text embeddings (anfa) — LiteLLM. Gemini's provider reads GEMINI_API_KEY
# (distinct from GOOGLE_API_KEY).
EMBED_MODEL=gemini/gemini-embedding-001
GEMINI_API_KEY=

# =============================================================================
# Persistence — Postgres (REQUIRED)
# =============================================================================
# The platform is Postgres-only — there is no JSON / in-memory fallback.
# DATABASE_URL must be set: mute/token stores, per-tenant domain data
# (catalogue, orders), and conversation checkpoints all live in Postgres,
# shared across every tenant process. After setting it, run
# `uv run alembic upgrade head`.
#
# `docker compose up -d` starts Postgres locally from the three POSTGRES_* vars
# below (compose reads them from this file — change the password for anything
# beyond local dev). The bots run on the host and reach the container via the
# published port, so DATABASE_URL uses localhost and must match these creds:
#   DATABASE_URL=postgresql://ai_sales:ai_sales@localhost:5433/ai_sales
# After setting it, create the schema:  uv run alembic upgrade head
POSTGRES_USER=ai_sales
POSTGRES_PASSWORD=ai_sales
POSTGRES_DB=ai_sales
DATABASE_URL=

# =============================================================================
# Admin panel (optional — `uv sync --extra admin`, console script `admin-api`)
# =============================================================================
# A standalone FastAPI service that reads/writes the shared Postgres (mutes,
# token usage, conversation checkpoints). Requires DATABASE_URL to be set.
# It refuses to start unless ADMIN_PASSWORD and ADMIN_SESSION_SECRET are set.
#   generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_HOST=127.0.0.1
ADMIN_PORT=58210
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Set true when serving over HTTPS (production behind a TLS reverse proxy).
ADMIN_COOKIE_SECURE=false
# Browser origins allowed to call the API directly (CORS).
ADMIN_CORS_ORIGINS=http://localhost:5173
