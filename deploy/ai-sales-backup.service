[Unit]
Description=ai-sales: nightly Postgres dump (conversation corpus + full DB)
After=docker.service
Requires=docker.service
# A failed backup is a silent data-loss risk, so it raises the same alert as a
# crashed bot.
OnFailure=ai-agent-alert@%N.service

[Service]
Type=oneshot
User=marketing_ttlk_co_uk
Group=marketing_ttlk_co_uk
ExecStart=/usr/local/bin/ai-sales-backup.sh
